# Supabase — copie este arquivo para .env.local e preencha com valores reais.
# NUNCA versione o .env.local (já está no .gitignore).

# URL do projeto Supabase (público, exposto ao browser)
NEXT_PUBLIC_SUPABASE_URL=

# Chave anônima do Supabase (público, exposto ao browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave service role do Supabase (SECRETA — somente server-side, nunca expor ao cliente)
SUPABASE_SERVICE_ROLE_KEY=
